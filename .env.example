# ──────────────────────────────────────────────────────
# Configuração do Sistema de Gestão de Imóveis
# Copie este arquivo para .env e preencha os valores
# ──────────────────────────────────────────────────────

# Porta do servidor (padrão: 3000)
PORT=3000

# MongoDB (obtenha grátis em mongodb.com/atlas)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/imoveis

# ── Asaas (cobranças / boletos) ────────────────────────
# Ambiente: "sandbox" para testes, "production" para produção
ASAAS_ENV=sandbox
# Chave de API — Asaas → Configurações → Integrações → Chaves de API
ASAAS_API_KEY=
# Token do webhook (Asaas → Integrações → Webhooks)
ASAAS_WEBHOOK_TOKEN=

# ── E-mail (Gmail) ─────────────────────────────────────
# Host SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Seu e-mail Gmail
EMAIL_USER=seuemail@gmail.com
# Senha de App do Gmail (não a senha normal)
# Ative em: Conta Google → Segurança → Verificação em 2 etapas → Senhas de app
EMAIL_PASS=
# Nome que aparece no remetente
EMAIL_FROM=Sistema de Imóveis <seuemail@gmail.com>
# URL pública do sistema (usado nos e-mails)
APP_URL=https://seudominio.com.br
