# ──────────────────────────────────────────────────────
# Configuração do Sistema de Gestão de Imóveis
# Copie este arquivo para .env e preencha os valores
# ──────────────────────────────────────────────────────

# Porta do servidor (padrão: 3000)
PORT=3000

# Ambiente Asaas: "sandbox" para testes, "production" para produção
ASAAS_ENV=sandbox

# Chave de API do Asaas
# Obtenha em: https://www.asaas.com → Configurações → Integrações → Chaves de API
ASAAS_API_KEY=$aact_hmlg_COLE_SUA_CHAVE_AQUI

# Token de validação do webhook (opcional mas recomendado)
# Configure o mesmo valor no painel Asaas → Integrações → Webhooks
ASAAS_WEBHOOK_TOKEN=
